<!--
	Documentation extension (phpbbmodders/documentation) — deny direct
	web access to the raw Hugo docs build on IIS, the same way phpBB's
	own root web.config hides cache/, files/, store/, etc. via
	hiddenSegments. Without this, the built pages are reachable directly
	at their real filesystem path, bypassing the extension's
	per-section/per-language ACL checks entirely.

	Merge this <location> block into your site's existing web.config
	(inside the top-level <configuration> element, alongside phpBB's own
	<location path="ext"> and <location path="images/avatars"> blocks —
	see phpBB's root web.config for exactly where those live). Don't
	replace your existing web.config with just this file.

	This mirrors phpBB's own pattern of hiding a specific segment scoped
	to one location (its own web.config hides "upload" scoped to
	"images/avatars"), rather than a directory-wide deny — IIS's
	hiddenSegments matches by path segment name, not by subtree, so this
	only takes effect for requests under ext/phpbbmodders/documentation/.
-->
<location path="ext/phpbbmodders/documentation">
	<system.webServer>
		<security>
			<requestFiltering>
				<hiddenSegments>
					<add segment="docs-build" />
				</hiddenSegments>
			</requestFiltering>
		</security>
	</system.webServer>
</location>
